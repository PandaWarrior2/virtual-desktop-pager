# Build output and runtime logs
/bin/
/obj/
*.obj
*.res
*.pdb
*.ilk
*.exp
*.lib
*.log

# Local test reports
/tests/*-result.txt
/tests/*status.txt

# IDE and editor state
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.VC.db
*.VC.opendb

# Python caches used by asset tooling
__pycache__/
*.py[cod]
/.venv/

# Machine-specific shortcuts and Windows metadata
*.lnk
Thumbs.db
Desktop.ini

# Keep assets/vdesktop.ico and assets/vdesktop.png: they are build inputs.
# Keep vdesktop.ini: it contains the default application configuration.
